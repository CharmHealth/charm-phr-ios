#Uncomment the next line to define a global platform for your project
 platform :ios, '15.0'

#source
source 'https://zrepository.zoho.com/MedicalMine/charm/Mobile_Team/charm_pod_specs.git'
source 'https://github.com/CocoaPods/Specs'

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end

use_modular_headers!
target 'phr' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for phr

  pod 'UICKeyChainStore'
  pod 'CharmCommonComponents' , '1.0' , :source => 'https://zrepository.zoho.com/MedicalMine/charm/Mobile_Team/charm_pod_specs.git'

  pod 'MDTextField' , '1.1'  , :source => 'https://zrepository.zoho.com/MedicalMine/charm/Mobile_Team/charm_pod_specs.git'
  #pod 'ZAnalytics' , '1.1.9.1'
  pod 'Apptics-Swift','3.3.2' , :source => 'https://github.com/zoho/Apptics.git'
  pod 'AppticsInAppUpdate' ,'3.3.2' , :source => 'https://github.com/zoho/Apptics.git'
  pod 'AppticsRateUs' , '3.3.2' , :source => 'https://github.com/zoho/Apptics.git'

  pod 'JTAppleCalendar', '8.0.5'
 # pod 'Charts'
 
 
 # Pre build script will register the app version, upload dSYM file to the server and add apptics specific information to the main info.plist which will be used by the SDK.
 script_phase :name => 'Apptics pre build', :script => 'sh "./Pods/Apptics-SDK/scripts/run" --upload-symbols-for-configurations="Release, Appstore" --config-file-path="${APPTICS_PATH}"', :execution_position => :before_compile
    
  target 'phrTests' do
    inherit! :search_paths
    # Pods for testing
  end

  target 'phrUITests' do
    inherit! :search_paths
    # Pods for testing
  end
  
 # post_install do |installer|
  #    puts system('sh ./Pods/Apptics-SDK/scripts/postinstaller --prefix="AP" --target-name="phr" --config-file-path="PHR/SupportingFiles/charm-apptics-config.plist"')
   # end

end
